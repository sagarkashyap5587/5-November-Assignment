
NODE_ENV=development
PORT=3000

MONGO_URI=mongodb://127.0.0.1:27017/splitease
REDIS_URL=redis://127.0.0.1:6379
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672

JWT_ACCESS_SECRET=replace_with_64_character_random_secret
JWT_REFRESH_SECRET=replace_with_another_64_character_random_secret

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=12

CORS_ORIGIN=http://localhost:3001

SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SplitEase <noreply@splitease.local>"

LOG_LEVEL=debug
